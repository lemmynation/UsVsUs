# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Leave all three blank to use in-memory rooms in local development.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret: server only. Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SECRET_KEY=

# Optional: "memory" forces in-memory rooms even if Supabase is configured (used by E2E tests).
ROOM_STORE=

# Premium packs (optional). Leave blank to hide premium.
# PayMongo test key from dashboard → Developers → API keys. Never commit a live key.
PAYMONGO_SECRET_KEY=
# From the webhook you create for /api/payments/webhook (needs a public URL).
PAYMONGO_WEBHOOK_SECRET=
# Public site address (e.g. https://usvsus.app). Required in production for payments.
APP_URL=
# "fake" = local test checkout for development and E2E tests only.
PAYMENT_PROVIDER=
